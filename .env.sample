# Agent backend selection: "openrouter" or "gemini-cli"
AGENT_BACKEND=gemini-cli

# --- OpenRouter ---
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.5-flash-lite

# --- Gemini CLI ---
GEMINI_MODEL=gemini-2.5-flash
GEMINI_CLI_PATH=
GEMINI_NODE_PATH=
GEMINI_API_KEY=
GOOGLE_API_KEY=
GEMINI_DEFAULT_AUTH_TYPE=gemini-api-key
# Optional: isolate Gemini CLI auth/settings (recommended for headless runs)
# GEMINI_CLI_HOME=.gemini-cli-home
